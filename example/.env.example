# Copy this file to .env and fill in the value for your environment.

# Local development — Vite serves example/public/dictionary.json at /dictionary.json
VITE_DICTIONARY_URL=/dictionary.json

# Production — use an immutable versioned CDN tag (never @latest)
# VITE_DICTIONARY_URL=https://cdn.jsdelivr.net/gh/trailofdad/morphkit-dictionary@1.1.0/dictionary.json
